# Banco SQLite local e fontes
COTACOES_DB_PATH=./data/cotacoes.sqlite3
COTACOES_CACHE_MINUTES=30
COTACOES_FUNDAMENTALS_TTL_HOURS=24
COTACOES_DIVIDENDS_TTL_HOURS=24
COTACOES_SEED_DEFAULTS=1
# COTACOES_FRONTEND_DIR=/caminho/absoluto/frontend

# Autenticacao opcional para uso em rede (requer header X-API-Key)
# COTACOES_API_TOKEN=defina-uma-chave-forte
